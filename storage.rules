rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // 1. Lot Inspection & Quality Photos
    match /lots/{lotId}/{allImages=**} {
      allow read: if true; // Public verified quality certificates
      allow write: if request.auth != null;
    }
    
    // 2. User & KYC Profile Documents
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin');
    }
    
    // 3. Dispute Evidence Photos
    match /disputes/{disputeId}/{evidence=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
